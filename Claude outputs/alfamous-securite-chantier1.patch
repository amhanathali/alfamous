From 27c74801360a5561048566bdc1276ccee8b85dd9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 11:10:43 -0500
Subject: [PATCH 2/2] =?UTF-8?q?S=C3=A9curit=C3=A9=20(chantier=201)=20:=20n?=
 =?UTF-8?q?e=20plus=20conserver=20le=20mot=20de=20passe=20dans=20localStor?=
 =?UTF-8?q?age?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Le mot de passe saisi était recopié en clair dans localStorage (codeUser,
lastNonAnonCodeUser) pour préremplir le formulaire. Tout script exécuté dans la
page pouvait le lire. Les anciennes copies sont effacées au chargement ; le
préremplissage est laissé au gestionnaire de mots de passe du navigateur.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015FaTMeXaJRL72GKgnSa8YF
---
 CHANGELOG.md             |  2 ++
 public/jsZC/connexion.js | 27 ++++++++++++++++-----------
 2 files changed, 18 insertions(+), 11 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 70d5580..a7d9d3c 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -29,6 +29,8 @@ et le projet suit le [versionnage sémantique](https://semver.org/lang/fr/).
 - **Rôles** : dans `demandeCollaborerLexique`, le champ `niveau` n'est plus modifiable que par
   un administrateur ; chaque membre ne lit que sa propre fiche ; la collection n'est plus en
   lecture publique (règles Firestore).
+- Le mot de passe n'est plus conservé dans le `localStorage` du navigateur (les anciennes
+  copies sont effacées au chargement).
 - Tests des règles avec l'émulateur Firebase (`tests/rules/`).
 - Exclusion du suivi Git de tous les secrets (clés de service Firebase Admin,
   secret client OAuth, identifiants de connexion rapide, `key.json`).
diff --git a/public/jsZC/connexion.js b/public/jsZC/connexion.js
index 9ceed24..a4d0cc7 100644
--- a/public/jsZC/connexion.js
+++ b/public/jsZC/connexion.js
@@ -32,30 +32,36 @@ function zcFirebaseHasRealSignedInUser() {
 }
 window.zcFirebaseHasRealSignedInUser = zcFirebaseHasRealSignedInUser;
 
-function zcRememberLastNonAnonUser(name, mail, code) {
+/**
+ * Sécurité : le mot de passe n'est plus conservé dans le navigateur (localStorage est lisible
+ * par tout script de la page). On efface les copies laissées par les versions précédentes ;
+ * le préremplissage du mot de passe est laissé au gestionnaire de mots de passe du navigateur.
+ */
+(function zcPurgeMotDePasseLocal() {
+  try {
+    localStorage.removeItem('codeUser');
+    localStorage.removeItem('lastNonAnonCodeUser');
+  } catch (_) { }
+})();
+
+function zcRememberLastNonAnonUser(name, mail) {
   var safeMail = String(mail || '').trim().toLowerCase();
   if (!safeMail || zcIsAnonymeCourriel(safeMail)) return;
   try {
     localStorage.setItem('lastNonAnonMailUser', safeMail);
     localStorage.setItem('lastNonAnonNameUser', String(name || '').trim());
-    if (code != null && String(code).trim() !== '') {
-      localStorage.setItem('lastNonAnonCodeUser', String(code));
-    }
   } catch (_) { }
 }
 
 function zcGetLastNonAnonUser() {
   var lastMail = '';
   var lastName = '';
-  var lastCode = '';
   try {
     lastMail = String(localStorage.getItem('lastNonAnonMailUser') || '').trim().toLowerCase();
     lastName = String(localStorage.getItem('lastNonAnonNameUser') || '').trim();
-    lastCode = String(localStorage.getItem('lastNonAnonCodeUser') || '').trim();
-    if (!lastCode) lastCode = String(localStorage.getItem('codeUser') || '').trim();
   } catch (_) { }
   if (!lastMail || zcIsAnonymeCourriel(lastMail)) return null;
-  return { mail: lastMail, name: lastName, code: lastCode };
+  return { mail: lastMail, name: lastName };
 }
 
 function zcRefreshForumIfOpen() {
@@ -522,7 +528,7 @@ async function fctLogInUser() {
       else elMail.value = mailStr;
     }
     if (elCode && 'value' in elCode) {
-      elCode.value = (lastNonAnon && lastNonAnon.code) ? lastNonAnon.code : '';
